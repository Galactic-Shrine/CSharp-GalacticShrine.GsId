<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <AssemblyName>GalacticShrine.GsId</AssemblyName>
    <RootNamespace>GalacticShrine.GsId</RootNamespace>
    <PackageId>GalacticShrine.GsId</PackageId>
    <Version>1.0.2</Version>

    <Authors>⋞Galactic-Shrine⋟</Authors>
    <Company>⋞Galactic-Shrine⋟</Company>
    <Product>GsId</Product>
    <Description>GsId 256-bit identifier system for Galactic-Shrine projects.</Description>

    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Galactic-Shrine/GalacticShrine.GsId</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Galactic-Shrine/GalacticShrine.GsId</PackageProjectUrl>

    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>gsid;identifier;uid;uuid;galactic-shrine</PackageTags>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
  </ItemGroup>

</Project>